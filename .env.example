# Docker-Betrieb: Secret Key für JWT und Verschlüsselung.
# Erzeugen mit: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
TRI_SECRET_KEY=

# Zugang zum Claude-Abo, mit dem die App den nächsten Trainingsblock selbst
# plant. Erzeugen mit `claude setup-token` auf einem Rechner mit Claude Code.
# Leer lassen ist in Ordnung — dann bleibt es beim Weg über die Zwischenablage.
CLAUDE_CODE_OAUTH_TOKEN=
